# ===========================================
# NEXTOR AI ASSISTANT - ENVIRONMENT VARIABLES
# ===========================================

# Google Gemini API Key (Required for AI features)
# Get your free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration (Production Security)
# Comma-separated list of allowed origins
# Development: Use * for all origins
# Production: Specify your domain(s)
# Example: https://nextor.example.com,https://www.nextor.example.com
ALLOWED_ORIGINS=*

# Rate Limiting
# Maximum requests per minute per IP address
RATE_LIMIT=60

# Server Configuration
# Port for local development (Render/Heroku set this automatically in production)
PORT=5000

# Python Version (for deployment platforms)
PYTHON_VERSION=3.11.0
