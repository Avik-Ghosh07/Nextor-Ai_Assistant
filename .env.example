# ========================================
# NEXTOR AI ASSISTANT - ENVIRONMENT CONFIGURATION
# ========================================
# Multi-LLM Support: OpenAI, Anthropic, Groq, Gemini
# Copy this file to .env and add your API keys

# ========================================
# LLM Provider Configuration
# ========================================

# Choose your preferred LLM provider (auto, openai, anthropic, groq, gemini)
# Set to 'auto' to automatically use the first available provider
LLM_PROVIDER=auto

# ----------------------------------------
# OpenAI Configuration (Recommended for Quality)
# ----------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Models: gpt-4o, gpt-4o-mini (recommended for cost), gpt-4-turbo, gpt-3.5-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------
# Anthropic Claude Configuration
# ----------------------------------------
# Get your API key from: https://console.anthropic.com/
# Models: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022 (recommended), claude-3-opus-20240229
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ----------------------------------------
# Groq Configuration (Ultra-Fast & Free Tier)
# ----------------------------------------
# Get your free API key from: https://console.groq.com/
# Models: llama-3.3-70b-versatile (recommended), llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------
# Google Gemini Configuration
# ----------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey
# Models: gemini-2.0-flash-exp (recommended), gemini-1.5-flash, gemini-1.5-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# ========================================
# Server Configuration
# ========================================

# CORS - Allowed origins (comma-separated, use * for all)
ALLOWED_ORIGINS=*

# Rate limiting - Maximum requests per minute per IP
RATE_LIMIT=60

# Server port (for local development)
PORT=5000

# Python Version (for deployment platforms)
PYTHON_VERSION=3.11.0

# ========================================
# Quick Setup Guide
# ========================================
# 
# 1. FREE OPTIONS (No Cost):
#    - Groq: Sign up at console.groq.com - Free tier with very fast inference
#    - Gemini: Free tier available at makersuite.google.com
#
# 2. PAID OPTIONS (Better Quality):
#    - OpenAI: Best overall quality - Pay per use
#    - Anthropic: Excellent for reasoning - Pay per use
#
# 3. RECOMMENDED SETUP:
#    - Primary: Groq (free, fast) or OpenAI (paid, best quality)
#    - Fallback: Gemini (free tier)
#
# 4. MULTI-PROVIDER SETUP (Recommended):
#    Add API keys for multiple providers - the app will automatically
#    fallback if one provider fails or hits rate limits
#
# Example multi-provider setup:
# OPENAI_API_KEY=sk-proj-...      # Primary (best quality)
# GROQ_API_KEY=gsk_...            # Fallback 1 (fast & free)
# GEMINI_API_KEY=AIza...          # Fallback 2 (free tier)
#
# ========================================
